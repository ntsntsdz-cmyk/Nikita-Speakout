/* ========== WRITING FEEDBACK (LanguageTool) ========== */
document.querySelectorAll('.btn-write').forEach(btn => {
  btn.addEventListener('click', async () => {
    const id = btn.dataset.textarea;
    const ta = document.querySelector(`[data-sid="${id}"]`);
    const box = document.getElementById('lt-' + id);
    if (!ta || !box) return;
    const text = ta.value.trim();
    if (!text) { box.innerHTML = '<p>Write something first.</p>'; box.classList.add('visible'); return; }
    box.innerHTML = '<p>Checking…</p>';
    box.classList.add('visible');

    try {
      const res = await fetch('https://api.languagetool.org/v2/check', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams({ language: 'en-GB', text })
      });
      if (!res.ok) throw new Error('API error');
      const data = await res.json();
      let html = '';

      // local style heuristics
      const styleIssues = [];
      if (/\b(gonna|wanna|gotta|kinda|sorta)\b/i.test(text)) {
        styleIssues.push({ what: 'Informal form (gonna/wanna…)', why: 'Prefer full forms in formal or careful writing.', try: null });
      }
      if (/\b(lol|omg|btw|idk|tbh)\b/i.test(text)) {
        styleIssues.push({ what: 'Chat abbreviation', why: 'Avoid in academic or formal writing.', try: null });
      }
      if (text === text.toUpperCase() && text.length > 15) {
        styleIssues.push({ what: 'ALL CAPS', why: 'Looks like shouting; use normal capitalisation.', try: null });
      }
      if (/[.!?].{120,}/.test(text.replace(/\n/g, ' '))) {
        styleIssues.push({ what: 'Very long sentence', why: 'Consider splitting into shorter sentences for clarity.', try: null });
      }
      if (/\b(thing|stuff)\b/i.test(text)) {
        styleIssues.push({ what: 'Vague word (thing/stuff)', why: 'Prefer a more precise noun.', try: null });
      }
      if (/\b(very|really|so)\s+(very|really|so)\b/i.test(text)) {
        styleIssues.push({ what: 'Repeated intensifier', why: 'One intensifier is usually enough.', try: null });
      }

      const matches = data.matches || [];
      if (!matches.length && !styleIssues.length) {
        html = '<p style="color:var(--green)">✓ No issues found. Good job!</p>';
      } else {
        matches.forEach(m => {
          const sug = (m.replacements || []).slice(0, 3).map(r => r.value);
          html += `<div class="lt-issue">
            <div class="what">${m.message}</div>
            <div class="why">${m.rule?.description || ''}</div>
            ${sug.length ? `<div class="try">Try: ${sug.map(s => `<span data-offset="${m.offset}" data-len="${m.length}" data-sug="${s}">${s}</span>`).join('')}</div>` : ''}
          </div>`;
        });
        styleIssues.forEach(s => {
          html += `<div class="lt-issue style">
            <div class="what">${s.what}</div>
            <div class="why">${s.why}</div>
          </div>`;
        });
      }
      box.innerHTML = html;

      // clickable suggestions
      box.querySelectorAll('.try span').forEach(span => {
        span.addEventListener('click', () => {
          const off = parseInt(span.dataset.offset);
          const len = parseInt(span.dataset.len);
          const sug = span.dataset.sug;
          const before = ta.value.slice(0, off);
          const after = ta.value.slice(off + len);
          ta.value = before + sug + after;
          ta.dispatchEvent(new Event('input'));
          span.closest('.lt-issue').style.opacity = '.5';
        });
      });
    } catch (err) {
      box.innerHTML = '<p>Could not check writing (needs internet). Please try again later.</p>';
    }
  });
});

