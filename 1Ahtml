/* ========== WORD POPUP ========== */
const popup = document.getElementById('word-popup');
let popupIgnoreOutside = false;

function showPopup(word, x, y) {
  const w = word.toLowerCase().replace(/[^a-z'-]/g, '');
  if (!w || w.length < 2) return;
  popup.style.display = 'block';
  popup.style.left = Math.min(x, window.innerWidth - 340) + 'px';
  popup.style.top = (y + 12) + 'px';
  document.getElementById('wpWord').textContent = w;
  document.getElementById('wpPos').textContent = '';
  document.getElementById('wpDef').textContent = 'Looking up…';
  document.getElementById('wpEx').textContent = '';
  popupIgnoreOutside = true;
  setTimeout(() => { popupIgnoreOutside = false; }, 400);

  // glossary first
  if (GLOSSARY[w]) {
    const g = GLOSSARY[w];
    document.getElementById('wpPos').textContent = g.pos;
    document.getElementById('wpDef').textContent = g.def;
    document.getElementById('wpEx').textContent = g.ex || '';
    return;
  }

  // Datamuse then Free Dictionary
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), 8000);

  fetch(`https://api.datamuse.com/words?sp=${encodeURIComponent(w)}&md=d&max=1`, { signal: ctrl.signal })
    .then(r => r.json())
    .then(data => {
      clearTimeout(timer);
      if (data && data[0] && data[0].defs && data[0].defs[0]) {
        const def = data[0].defs[0];
        const parts = def.split('\t');
        document.getElementById('wpPos').textContent = parts[0] || '';
        document.getElementById('wpDef').textContent = parts[1] || def;
        return;
      }
      return fetch(`https://api.dictionaryapi.dev/api/v2/entries/en/${encodeURIComponent(w)}`, { signal: ctrl.signal })
        .then(r => r.json())
        .then(data => {
          if (Array.isArray(data) && data[0]) {
            const e = data[0];
            const m = e.meanings && e.meanings[0];
            document.getElementById('wpPos').textContent = m ? m.partOfSpeech : '';
            document.getElementById('wpDef').textContent = m && m.definitions[0] ? m.definitions[0].definition : 'No definition found.';
            const ex = m && m.definitions[0] && m.definitions[0].example;
            document.getElementById('wpEx').textContent = ex || '';
          } else {
            document.getElementById('wpDef').textContent = 'No definition found.';
          }
        });
    })
    .catch(() => {
      clearTimeout(timer);
      document.getElementById('wpDef').textContent = 'Lookup failed (offline or timeout).';
    });
}

