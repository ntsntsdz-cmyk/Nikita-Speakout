function collectScores() {
  const exercises = ['2a','2b','3a','3b','4a','5a','5b','6a','8a','9a'];
  const results = [];
  let totalC = 0, totalT = 0;
  exercises.forEach(ex => {
    const r = checkEx(ex);
    totalC += r.correct;
    totalT += r.total;
    results.push({ id: ex, ...r });
  });
  return { results, totalC, totalT, pct: totalT ? Math.round(100 * totalC / totalT) : 0 };
}

