<script>
/* ========== CONFIG ========== */
const STORAGE_KEY = '1A_personality_language_exp_';
const GLOSSARY = {
  "open": { pos: "adj.", def: "willing to talk and share feelings; friendly and not closed.", ex: "She is a very open person." },
  "friendly": { pos: "adj.", def: "behaving in a kind, pleasant way towards someone.", ex: "People in the South are more friendly." },
  "influence": { pos: "v./n.", def: "to have an effect on the way someone thinks or behaves.", ex: "Language can influence our thinking." },
  "impact": { pos: "n./v.", def: "a strong effect or influence on someone or something.", ex: "The place has a big impact on you." },
  "unique": { pos: "adj.", def: "being the only one of its kind; special.", ex: "All these make us unique." },
  "shape": { pos: "v.", def: "to influence the way something develops.", ex: "Life experience shapes your thinking." },
  "personality": { pos: "n.", def: "the combination of characteristics that form a person's character.", ex: "These factors influence your personality." },
  "opportunity": { pos: "n.", def: "a chance to do something.", ex: "I travel every time I have the opportunity." },
  "culture": { pos: "n.", def: "the customs, ideas and social behaviour of a particular people.", ex: "Language forms our culture." },
  "idiom": { pos: "n.", def: "a group of words with a meaning that is different from the meanings of the individual words.", ex: "Idioms are part of our culture code." },
  "discourse": { pos: "n.", def: "written or spoken communication; the way we organise ideas in text.", ex: "Discourse markers help organise ideas." },
  "collocation": { pos: "n.", def: "a combination of words that often go together.", ex: "‘Open and friendly’ is a common collocation." }
};

/* ========== NORMALIZE & isOk ========== */
function normalize(s) {
  if (s == null) return '';
  return String(s)
    .toLowerCase()
    .trim()
    .replace(/[\u2018\u2019\u201A\u201B]/g, "'")
    .replace(/[\u201C\u201D\u201E\u201F]/g, '"')
    .replace(/\s+/g, ' ')
    .replace(/[.?!]+$/, '')
    .trim();
}

function isOk(user, answer) {
  if (!answer) return false;
  const u = normalize(user);
  if (!u) return false;
  const parts = String(answer).split('|').map(a => normalize(a));
  for (const p of parts) {
    if (!p) continue;
    if (u === p) return true;
    if (p.length > 2 && (u.includes(p) || p.includes(u))) return true;
    // any comma-separated piece
    const commas = p.split(',').map(x => x.trim()).filter(Boolean);
    for (const c of commas) {
      if (c.length > 2 && (u === c || u.includes(c) || c.includes(u))) return true;
    }
  }
  return false;
}

/* ========== LIVE CHECKING ========== */
function liveCheck(el) {
  const ans = el.getAttribute('data-answer');
  if (!ans) return;
  const val = el.value;
  if (!val.trim()) {
    el.classList.remove('ok', 'bad');
    return;
  }
  // prefix match for progressive feedback
  const u = normalize(val);
  const parts = ans.split('|').map(a => normalize(a));
  let good = false;
  let prefix = false;
  for (const p of parts) {
    if (!p) continue;
    if (u === p || (p.length > 2 && (u.includes(p) || p.includes(u)))) { good = true; break; }
    if (p.startsWith(u) || u.startsWith(p.slice(0, Math.min(u.length, p.length)))) prefix = true;
  }
  el.classList.remove('ok', 'bad');
  if (good) el.classList.add('ok');
  else if (prefix && u.length > 0) el.classList.add('ok');
  else el.classList.add('bad');
}

document.querySelectorAll('input[data-answer], select[data-answer]').forEach(el => {
  el.addEventListener('input', () => liveCheck(el));
  el.addEventListener('change', () => liveCheck(el));
});

/* ========== SCORE & CHECK / SHOW / CLEAR ========== */
function getExInputs(exId) {
  return document.querySelectorAll(`[data-ex="${exId}"] [data-answer]`);
}

function checkEx(exId) {
  const inputs = getExInputs(exId);
  let correct = 0, total = 0;
  inputs.forEach(el => {
    // skip empty correction fields when TF is True
    if (el.classList.contains('tf-correction')) {
      const sel = el.closest('.row').querySelector('.tf-select');
      if (sel && normalize(sel.value) === 'true') {
        el.classList.remove('ok', 'bad');
        return;
      }
    }
    const ans = el.getAttribute('data-answer');
    if (ans === '' || ans == null) return; // empty answer means no score
    total++;
    if (isOk(el.value, ans)) {
      el.classList.add('ok');
      el.classList.remove('bad');
      correct++;
    } else {
      el.classList.add('bad');
      el.classList.remove('ok');
    }
  });
  const pill = document.getElementById('score-' + exId);
  if (pill) pill.textContent = correct + '/' + total;
  return { correct, total };
}

function showAnswers(exId) {
  const inputs = getExInputs(exId);
  inputs.forEach(el => {
    const ans = el.getAttribute('data-answer');
    if (!ans) return;
    const first = ans.split('|')[0];
    if (el.tagName === 'SELECT') {
      // try to select matching option
      for (const opt of el.options) {
        if (normalize(opt.value) === normalize(first) || isOk(opt.value, ans)) {
          el.value = opt.value;
          break;
        }
      }
    } else {
      el.value = first;
    }
    el.classList.add('ok');
    el.classList.remove('bad');
    const rev = document.querySelector(`.ans-reveal[data-for="${el.dataset.sid}"]`);
    if (rev) { rev.textContent = first; rev.classList.add('show'); }
  });
  checkEx(exId);
}

function clearEx(exId) {
  const inputs = getExInputs(exId);
  inputs.forEach(el => {
    if (el.tagName === 'SELECT') el.selectedIndex = 0;
    else el.value = '';
    el.classList.remove('ok', 'bad');
    const rev = document.querySelector(`.ans-reveal[data-for="${el.dataset.sid}"]`);
    if (rev) rev.classList.remove('show');
  });
  const pill = document.getElementById('score-' + exId);
  if (pill) {
    const total = [...inputs].filter(e => e.getAttribute('data-answer')).length;
    pill.textContent = '0/' + total;
  }
}

